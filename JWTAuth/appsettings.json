{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "Jwt": {
    "Audience": "jwtauth-browser",
    "Issuer": "jwtauth-local",
    "AccessTokenLifetimeSeconds": 300
  },
  "Session": {
    "AbsoluteLifetimeHours": 168,
    "RedisKeyPrefix": "jwtauth:"
  }
}
