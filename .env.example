# Copy to .env and replace every placeholder. This file contains no usable secrets.
POSTGRES_PASSWORD=replace-with-a-local-database-password
REDIS_PASSWORD=replace-with-a-local-redis-password
JWT_SIGNING_KEY=replace-with-at-least-32-random-utf8-bytes
HTTPS_CERT_PASSWORD=replace-with-a-local-certificate-password
ACCESS_TOKEN_LIFETIME_SECONDS=300
